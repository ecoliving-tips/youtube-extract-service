EXTRACT_API_KEY=replace-with-a-long-random-secret
MAX_DURATION_SECONDS=480
MAX_AUDIO_BYTES=31457280
OUTPUT_AUDIO_BITRATE_KBPS=96
EXTRACTION_TIMEOUT_SECONDS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=5
CACHE_TTL_SECONDS=1800
CACHE_MAX_ITEMS=2

# Optional, operator-managed cookie file. Never commit this file.
# YT_DLP_COOKIES_FILE=/run/secrets/youtube-cookies.txt

# Optional compliant fallback service.
# FALLBACK_PROVIDER_URL=https://provider.example/extract
# FALLBACK_PROVIDER_API_KEY=replace-with-provider-secret
